# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.
# O projeto funciona com qualquer API compativel com OpenAI: troque apenas
# estas tres variaveis para mudar de provedor.

# --- Groq (padrao do projeto, camada gratuita) ---------------------------
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=sua-chave-aqui
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini (Google AI Studio) -------------------------------------------
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=sua-chave-aqui
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Ollama local (gratis, dados nao saem da maquina) --------------------
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# --- Ajustes opcionais ---------------------------------------------------
# Temperatura 0 deixa as respostas mais consistentes (recomendado para dados).
LLM_TEMPERATURA=0.0

# No Streamlit Community Cloud nao existe .env: cole estas mesmas variaveis
# no painel (Advanced settings -> Secrets), no formato:
#   LLM_MODEL = "openai/gpt-oss-120b"
#   LLM_API_KEY = "sua-chave"
#   LLM_BASE_URL = "https://api.groq.com/openai/v1"
